# Copy to .env
CLIPFORGE_ENV=development
CLIPFORGE_LOG_LEVEL=INFO

# Storage
CLIPFORGE_DATA_DIR=./data

# Transcription
CLIPFORGE_TRANSCRIBER=whisper

# Processing
CLIPFORGE_FFMPEG_BIN=ffmpeg
CLIPFORGE_FFPROBE_BIN=ffprobe

# Candidate scoring
CLIPFORGE_MAX_CANDIDATES=20
CLIPFORGE_MIN_CLIP_SECONDS=15
CLIPFORGE_MAX_CLIP_SECONDS=90

# API
CLIPFORGE_API_HOST=127.0.0.1
CLIPFORGE_API_PORT=8000

# LLM Viral Hooks (9Router / OpenAI-compatible endpoint)
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=https://api.9router.com/v1
NINEROUTER_MODEL=openai/gpt-4o-mini
